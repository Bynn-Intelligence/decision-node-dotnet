<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Bynn.DecisionNode</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Bynn.DecisionNode</PackageId>
    <Version>0.4.1</Version>
    <Authors>Bynn Intelligence</Authors>
    <Company>Bynn Intelligence, Inc.</Company>
    <Copyright>Copyright (c) Bynn Intelligence, Inc.</Copyright>
    <Description>The official .NET client for the DecisionNode decision engine API: ask yes-or-no, choice, score and number questions about any state and get calibrated probabilities back, one at a time, in sessions or in batches.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://decisionnode.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Bynn-Intelligence/decision-node-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>decisionnode;decision-engine;decisions;classification;api;sdk;websocket;batch</PackageTags>
    <!-- A symbols package (.snupkg) beside the .nupkg, for source-level debugging. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bynn.DecisionNode.Tests" />
    <InternalsVisibleTo Include="Bynn.DecisionNode.Conformance" />
  </ItemGroup>

</Project>
